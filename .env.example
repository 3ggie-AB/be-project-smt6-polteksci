APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=netmonitor
MYSQL_PASSWORD=netmonitor
MYSQL_DATABASE=netmonitor
MYSQL_LOCATION=Asia%2FJakarta

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-token-change-me
INFLUX_ORG=netmonitor
INFLUX_BUCKET=network_metrics
INFLUX_BATCH_SIZE=500
INFLUX_FLUSH_INTERVAL=2s
INFLUX_QUEUE_SIZE=10000
INFLUX_MAX_RETRIES=3
INFLUX_RETRY_INTERVAL=500ms

JWT_SECRET=change-me-in-production
JWT_ISSUER=netmonitor
JWT_TTL=24h
ADMIN_EMAIL=admin@netmonitor.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=NetMonitor Admin

PING_INTERVAL=5s
PING_TIMEOUT=3s
PING_COUNT=3
PING_WORKERS=512
TCP_INTERVAL=30s
TCP_TIMEOUT=3s
TCP_WORKERS=256
DEFAULT_TCP_PORT=443
HIGH_LATENCY_MS=150
HIGH_PACKET_LOSS_RATIO=0.2

RUIJIE_BASE_URL=
RUIJIE_API_KEY=
RUIJIE_AP_ENDPOINT=/api/telemetry/aps
RUIJIE_POLL_INTERVAL=30s
RUIJIE_REQUEST_TIMEOUT=10s
RUIJIE_DEBUG_RAW_JSON=false

SYSLOG_ENABLED=true
SYSLOG_ADDRESS=:5514

SNMP_ENABLED=true
SNMP_POLL_INTERVAL=60s
SNMP_PORT=161
SNMP_TIMEOUT=3s
SNMP_RETRIES=1
SNMP_CPU_OID=
SNMP_MEMORY_OID=
