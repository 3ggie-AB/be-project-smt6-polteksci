APP_NAME=NetMonitor API
APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=netmonitor
MYSQL_PASSWORD=netmonitor
MYSQL_DATABASE=netmonitor
MYSQL_LOCATION=Asia%2FJakarta

JWT_SECRET=change-me-in-production
SESSION_TTL=24h

MONITORING_ENABLED=true
PING_ENABLED=true
PING_INTERVAL=5s
PING_TIMEOUT=3s
PING_COUNT=3
PING_WORKERS=64
HIGH_LATENCY_MS=0
HIGH_PACKET_LOSS_RATIO=0

SNMP_ENABLED=false
SNMP_POLL_INTERVAL=60s
SNMP_PORT=161
SNMP_TIMEOUT=3s
SNMP_RETRIES=1
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_CPU_OID=
SNMP_MEMORY_OID=
SNMP_WORKERS=64
